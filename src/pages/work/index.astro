---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/content/projects';
---

<BaseLayout title="Work — Karthik Kumar" description="Selected engineering projects spanning AI/ML systems, security automation, and developer tooling">
  <section class="work-index">
    <header class="work-header">
      <h1>Work</h1>
      <p class="work-intro">Selected projects demonstrating systems-level engineering across AI/ML, security automation, and developer tooling.</p>
    </header>

    <div class="projects-list">
      {projects.map((project) => (
        <article class="project-card" data-storytelling-mode={project.storytellingMode}>
          <div class="project-meta">
            <span class="project-id">{project.id}</span>
            <span class="project-type">{project.storytellingMode}</span>
          </div>

          <h2>
            <a href={`/work/${project.id}`}>{project.title}</a>
          </h2>

          <p class="project-summary">{project.summary}</p>

          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          {project.links?.github && (
            <div class="project-links">
              <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="link-github">
                View repository →
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work-index {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
  }

  .work-header {
    max-width: var(--reading-max);
    margin-bottom: var(--space-16);
  }

  .work-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .work-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .projects-list {
    display: grid;
    gap: var(--space-12);
  }

  .project-card {
    padding: var(--space-8);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-teal-text-light);
  }

  .project-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
    font-family: var(--font-technical);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .project-id {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .project-type {
    opacity: 0.7;
  }

  .project-card h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .project-card h2 a {
    color: var(--color-text-on-light);
    transition: color 0.2s ease;
  }

  .project-card h2 a:hover,
  .project-card h2 a:focus {
    color: var(--color-teal-text-light);
  }

  .project-summary {
    color: var(--color-text-on-light);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-mist);
    color: var(--color-text-on-light);
    font-size: 0.8125rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-technical);
  }

  .project-links {
    margin-top: var(--space-4);
  }

  .link-github {
    display: inline-block;
    color: var(--color-teal-text-light);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .link-github:hover,
  .link-github:focus {
    color: var(--color-signal-text-light);
  }

  @media (max-width: 768px) {
    .work-index {
      padding: var(--space-8) var(--space-4);
    }

    .work-header {
      margin-bottom: var(--space-12);
    }

    .projects-list {
      gap: var(--space-8);
    }

    .project-card {
      padding: var(--space-6);
    }
  }
</style>
