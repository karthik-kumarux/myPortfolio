---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/content/projects';
---

<BaseLayout title="Work — Karthik Kumar" description="Portfolio of projects spanning generative AI, security automation, and developer tooling.">
  <section class="work-container">
    <header class="work-header">
      <h1>/PROJECTS</h1>
      <p class="work-intro text-muted font-mono">Index of deployed systems, security tools, and machine learning pipelines.</p>
    </header>

    <div class="work-grid">
      {projects.map((project) => (
        <article class="work-card">
          <div class="card-header">
            <h3>{project.title}</h3>
            <span class="work-type font-mono text-muted">[{project.tags[0]}]</span>
          </div>
          <p class="summary">{project.summary}</p>
          <a href={`/work/${project.id}`} class="work-link font-mono text-crimson" aria-label={`View ${project.title} case study`}>EXPLORE_DATA_SET</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .work-container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-32);
  }

  .work-header {
    margin-bottom: var(--space-16);
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-8);
  }

  .work-header h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .work-intro {
    font-size: 1rem;
    max-width: 600px;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--space-8);
  }

  .work-card {
    position: relative;
    border: var(--border-hairline);
    border-left: 2px solid rgba(255, 255, 255, 0.08);
    padding: var(--space-8);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(15, 15, 17, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    will-change: transform;
  }

  .work-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: linear-gradient(90deg, var(--color-crimson-glow) 0%, transparent 100%);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  .work-card:hover,
  .work-card:focus-within {
    border-color: rgba(255, 255, 255, 0.15);
    border-left-color: var(--color-crimson);
    background: rgba(20, 20, 22, 0.8);
  }

  .work-card:hover::before,
  .work-card:focus-within::before {
    width: 100%;
  }

  .card-header, .summary, .work-link {
    position: relative;
    z-index: 2;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-4);
  }

  .card-header h3 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .work-type {
    font-size: 0.75rem;
  }

  .summary {
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    flex-grow: 1;
  }

  .work-link {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .work-link::after {
    content: '>';
    transition: transform 0.2s ease;
  }

  .work-link:hover::after {
    transform: translateX(4px);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.work-card');
    cards.forEach(card => {
      const el = card as HTMLElement;
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;
        
        el.style.setProperty('--rx', `${rotateX}deg`);
        el.style.setProperty('--ry', `${rotateY}deg`);
      });
      
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
        el.style.transition = 'all 0.5s ease';
        setTimeout(() => { el.style.transition = 'all 0.3s cubic-bezier(0.16, 1, 0.3, 1)'; }, 500);
      });
    });
  });
</script>
