---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DecoderText from '@/components/DecoderText.jsx';
---

<BaseLayout title="Profile — Karthik Kumar" description="Professional profile, experience, and education for Karthik Kumar, Software Engineer.">
  <section class="profile-container">
    <header class="profile-header">
      <h1><DecoderText client:load text="KARTHIK_KUMAR" delay={300} /></h1>
      <p class="profile-role text-ice">Software Engineer</p>
      <div class="profile-disciplines font-mono text-muted">
        <span class="discipline">AI / ML Systems</span>
        <span class="discipline-separator text-crimson">·</span>
        <span class="discipline">Security Automation</span>
        <span class="discipline-separator text-crimson">·</span>
        <span class="discipline">Developer Tooling</span>
      </div>
    </header>

    <div class="profile-grid">
      <div class="profile-main">
        <section class="profile-section">
          <h2><DecoderText client:load text="/ABOUT" delay={600} /></h2>
          <p>
            I am a software engineer focused on building robust, reliable systems across generative AI, security, and developer tooling. I architect applications end to end—from problem selection and specification through local deployment pipelines to production integration. My experience spans Python and TypeScript, encompassing <span class="redactable">local LLM pipelines, asynchronous tasks, semantic retrieval, and static analysis.</span>
          </p>
        </section>

        <section class="profile-section">
          <h2>/EXPERIENCE</h2>

          <article class="timeline-item">
            <header>
              <h3>AI / Machine Learning Intern</h3>
              <p class="timeline-org text-ice font-mono">Viswa Robotic Cars</p>
            </header>
            <p class="timeline-date font-mono text-crimson">March 2026 &mdash; Present</p>
            <p class="timeline-desc">Contributing to AI/ML projects focusing on intelligent system development and model implementation, iterating on Python-based ML workflows.</p>
          </article>

          <article class="timeline-item">
            <header>
              <h3>Google Android Developer Intern</h3>
              <p class="timeline-org text-ice font-mono">EduSkills &times; AICTE</p>
            </header>
            <p class="timeline-date font-mono text-crimson">March 2026 &mdash; June 2026</p>
            <p class="timeline-desc">Developed Android applications using structured version control and standard software development workflows.</p>
          </article>

          <article class="timeline-item">
            <header>
              <h3>Machine Learning Intern</h3>
              <p class="timeline-org text-ice font-mono">Viswa Robotic Cars</p>
            </header>
            <p class="timeline-date font-mono text-crimson">June 2025 &mdash; August 2025</p>
            <p class="timeline-desc">Collaborated on data preprocessing, model development, and evaluation within industry-oriented AI development pipelines.</p>
          </article>

          <article class="timeline-item">
            <header>
              <h3>Cybersecurity Intern</h3>
              <p class="timeline-org text-ice font-mono">Cisco Networking Academy</p>
            </header>
            <p class="timeline-date font-mono text-crimson">June 2025 &mdash; August 2025</p>
            <p class="timeline-desc">Practical training in network security, cyber defense, and threat analysis fundamentals.</p>
          </article>
        </section>
      </div>

      <aside class="profile-sidebar">
        <section class="profile-section">
          <h2>/EDUCATION</h2>
          <article class="timeline-item compact">
            <header>
              <h3>B.Tech, Computer Science & Engineering (AI & ML)</h3>
              <p class="timeline-org text-ice font-mono">MITS</p>
            </header>
            <p class="timeline-date font-mono text-crimson">2023 &mdash; 2027</p>
          </article>
        </section>

        <section class="profile-section">
          <h2>/CAPABILITIES</h2>
          <ul class="capability-list">
            <li><strong class="text-ice">Programming:</strong> Python, TypeScript, C</li>
            <li><strong class="text-ice">Generative AI:</strong> LLM APIs, Tool Calling, Agent Loops, Semantic Retrieval, Local LLMs (Ollama)</li>
            <li><strong class="text-ice">AI / ML:</strong> Deep Learning, Computer Vision, YOLO, DistilBERT</li>
            <li><strong class="text-ice">Architecture:</strong> FastAPI, Node.js, Celery, Streamlit</li>
            <li><strong class="text-ice">Infrastructure:</strong> Docker, PostgreSQL, Redis, ChromaDB</li>
            <li><strong class="text-ice">Security:</strong> Vulnerability Assessment, OWASP ZAP, Nmap</li>
          </ul>
        </section>

        <section class="profile-section">
          <h2>/HIGHLIGHTS</h2>
          <ul class="capability-list">
            <li>Cyber Security Professional Program — Ethnotech</li>
            <li>Winner, Department-Level Project Expo</li>
            <li>HackerRank 3-Star Badge in C</li>
            <li>Coordinator, AIMEX 2K25 Technical Fest</li>
          </ul>
        </section>

        <div class="sidebar-actions">
          <a href="https://github.com/karthik-kumarux" target="_blank" rel="noopener noreferrer" class="social-link font-mono">GITHUB_PROFILE</a>
          <a href="https://linkedin.com/in/karthik-kumar-minuga" target="_blank" rel="noopener noreferrer" class="social-link font-mono">LINKEDIN_PROFILE</a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="social-link font-mono">VIEW_RESUME_PDF</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .profile-container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-16);
  }

  .profile-header {
    margin-bottom: var(--space-12);
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-8);
  }

  .profile-header h1 {
    font-size: clamp(3rem, 6vw, 5rem);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
    line-height: 1;
  }

  .profile-role {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    margin-bottom: var(--space-4);
  }

  .profile-disciplines {
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }

  .discipline-separator {
    margin: 0 var(--space-2);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-16);
  }

  .profile-section {
    margin-bottom: var(--space-12);
  }

  .profile-section h2 {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-6);
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-2);
  }

  .timeline-item {
    margin-bottom: var(--space-8);
    position: relative;
    padding-left: var(--space-6);
    border-left: 2px solid rgba(255,255,255,0.08);
    transition: border-color 0.3s;
  }
  
  .timeline-item:hover {
    border-left-color: var(--color-crimson);
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0;
    width: 8px;
    height: 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-ice-blue);
  }

  .timeline-item.compact {
    margin-bottom: var(--space-4);
  }

  .timeline-item h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .timeline-org {
    font-size: 0.875rem;
    margin-bottom: var(--space-2);
  }

  .timeline-date {
    font-size: 0.75rem;
    margin-bottom: var(--space-4);
  }

  .timeline-desc {
    color: var(--color-text-muted);
  }

  .capability-list {
    list-style: none;
    padding: 0;
  }

  .capability-list li {
    padding-left: var(--space-4);
    position: relative;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .capability-list li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--color-crimson);
    font-family: var(--font-mono);
  }

  .capability-list strong {
    font-weight: 400;
    margin-right: var(--space-2);
  }

  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--border-hairline);
  }

  .social-link {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--border-hairline);
    transition: all 0.2s ease;
  }

  .social-link::before {
    content: '>';
    color: var(--color-crimson);
  }

  .social-link:hover {
    border-color: var(--color-ice-blue);
    background: rgba(56, 189, 248, 0.1);
  }

  @media (max-width: 1024px) {
    .profile-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
