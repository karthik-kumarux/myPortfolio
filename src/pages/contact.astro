---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Karthik Kumar" description="Direct contact information for Karthik Kumar.">
  <section class="contact-container">
    <header class="contact-header">
      <h1>Contact</h1>
      <p class="contact-intro">Direct lines of communication. Standard response time is 24-48 hours for professional inquiries.</p>
    </header>

    <div class="contact-methods">
      <article class="contact-card">
        <h2>Email</h2>
        <p>Preferred for asynchronous communication and detailed technical inquiries.</p>
        <a href="mailto:karthikyt369@gmail.com" class="contact-link" aria-label="Send email to Karthik Kumar">
          karthikyt369@gmail.com
        </a>
      </article>

      <article class="contact-card">
        <h2>Professional Network</h2>
        <p>Available for networking, endorsements, and direct messaging regarding opportunities.</p>
        <a href="https://linkedin.com/in/karthik-kumar-minuga" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="Connect with Karthik Kumar on LinkedIn">
          linkedin.com/in/karthik-kumar-minuga ↗
        </a>
      </article>

      <article class="contact-card">
        <h2>Code Archive</h2>
        <p>Source repositories, open-source contributions, and experiment prototypes.</p>
        <a href="https://github.com/karthik-kumarux" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="View Karthik Kumar's GitHub repositories">
          github.com/karthik-kumarux ↗
        </a>
      </article>

      <!-- Optionally include Phone if it's considered safe. Given this is public internet, I will omit phone from web explicitly to avoid spam unless they read the resume PDF -->
    </div>
  </section>
</BaseLayout>

<style>
  .contact-container {
    max-width: var(--reading-max);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4) var(--space-16);
  }

  .contact-header {
    margin-bottom: var(--space-12);
  }

  .contact-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .contact-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .contact-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background-color: transparent;
    transition: border-color 0.2s ease;
  }

  .contact-card:hover,
  .contact-card:focus-within {
    border-color: var(--color-teal-text-light);
  }

  .contact-card h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: var(--space-2);
    color: var(--color-text-on-light);
  }

  .contact-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    font-size: 0.9375rem;
  }

  .contact-link {
    display: inline-block;
    font-family: var(--font-technical);
    font-size: 1rem;
    color: var(--color-teal-text-light);
    text-decoration: none;
    font-weight: 500;
  }

  .contact-link:hover,
  .contact-link:focus {
    color: var(--color-signal-text-light);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
