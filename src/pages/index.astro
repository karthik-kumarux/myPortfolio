---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/content/projects';
---

<BaseLayout title="Karthik Kumar — Software Engineer" description="Software Engineer specializing in AI / ML Systems, Security Automation, and Developer Tooling">
  <section class="hero">
    <h1>Karthik Kumar</h1>
    <p class="role">Software Engineer</p>
    <p class="specializations">AI / ML Systems · Security Automation · Developer Tooling</p>
  </section>

  <section class="selected-work">
    <h2>Selected Work</h2>
    <div class="work-grid">
      {projects.map((project) => (
        <article class="work-card">
          <h3>{project.title}</h3>
          <p class="work-type">{project.tags[0]}</p>
          <p>{project.summary}</p>
          <a href={`/work/${project.id}`} class="work-link" aria-label={`View ${project.title} case study`}>View case study</a>
        </article>
      ))}
    </div>
    <a href="/work" class="view-all">View all work</a>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: var(--reading-max);
    margin: var(--space-24) auto;
    padding: 0 var(--space-4);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .role {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .specializations {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-text-muted);
    font-family: var(--font-technical);
  }

  .selected-work {
    max-width: var(--content-max);
    margin: var(--space-32) auto;
    padding: 0 var(--space-4);
  }

  .selected-work h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    margin-bottom: var(--space-8);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .work-card {
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    transition: border-color 0.2s ease;
  }

  .work-card:hover,
  .work-card:focus-within {
    border-color: var(--color-teal-text-light);
  }

  .work-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .work-type {
    font-family: var(--font-technical);
    font-size: 0.875rem;
    color: var(--color-teal-text-light);
    margin-bottom: var(--space-3);
  }

  .work-card p:not(.work-type) {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .work-link {
    display: inline-block;
    color: var(--color-teal-text-light);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .work-link::after {
    content: ' →';
  }

  .view-all {
    display: inline-block;
    color: var(--color-teal-text-light);
    font-weight: 500;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-teal-text-light);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .view-all:hover,
  .view-all:focus {
    background-color: var(--color-teal-text-light);
    color: var(--color-field-paper);
  }

  @media (max-width: 768px) {
    .hero {
      margin: var(--space-16) auto;
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
