---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="SYSTEM_FAILURE - 404" description="Page not found.">
  <div class="kernel-panic">
    <div class="panic-content font-mono">
      <h1 class="panic-title">KERNEL_PANIC: 0x00000404</h1>
      <p class="panic-text">
        FATAL ERROR: The requested memory address could not be resolved.<br />
        PAGE_FAULT_IN_NONPAGED_AREA
      </p>
      
      <div class="hex-dump">
        0x0000: FF FF FF FF 00 00 00 00 45 52 52 4F 52 5F 34 30
        0x0010: 34 00 00 00 FF FF FF FF 00 00 00 00 00 00 00 00
        0x0020: 53 59 53 54 45 4D 5F 48 41 4C 54 45 44 00 00 00
      </div>

      <p class="panic-action">
        > <a href="/" class="reboot-btn">[ REBOOT_SYSTEM ]</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .kernel-panic {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #050505;
    color: var(--color-crimson);
    z-index: 99999;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--space-4);
  }

  .panic-content {
    max-width: 800px;
    width: 100%;
  }

  .panic-title {
    background-color: var(--color-crimson);
    color: #050505;
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-8);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    text-transform: uppercase;
  }

  .panic-text {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: var(--space-8);
    text-shadow: 0 0 10px rgba(225, 29, 72, 0.5);
  }

  .hex-dump {
    background: rgba(225, 29, 72, 0.1);
    border: 1px solid var(--color-crimson);
    padding: var(--space-4);
    font-size: 0.875rem;
    margin-bottom: var(--space-12);
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .panic-action {
    font-size: 1.5rem;
  }

  .reboot-btn {
    color: var(--color-ice-blue);
    text-decoration: none;
    transition: all 0.2s;
    animation: blink 2s infinite;
  }

  .reboot-btn:hover {
    color: #050505;
    background: var(--color-ice-blue);
    animation: none;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>
