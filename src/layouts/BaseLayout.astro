---
import { ClientRouter } from 'astro:transitions';
import Terminal from '@/components/Terminal.jsx';
import DataTicker from '@/components/DataTicker.jsx';
import MouseTrail from '@/components/MouseTrail.jsx';
import DefconToggle from '@/components/DefconToggle.jsx';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="website" />

  <ClientRouter />


  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  
  <script>
    // Console ASCII Art
    document.addEventListener('astro:page-load', () => {
      console.log("%c SYSTEM BREACH DETECTED ", "color: #e11d48; font-size: 20px; font-weight: bold; background: #050505; border: 1px solid #e11d48;");
      console.log("%c UNAUTHORIZED ACCESS ATTEMPT LOGGED. ", "color: #38bdf8; font-size: 14px;");
      console.log(`
      _  __    _    ____ _____ _   _ ___ _  __  _  ___   _ __  __    _    ____  
     | |/ /   / \\  |  _ \\_   _| | | |_ _| |/ / | |/ / | | |  \\/  |  / \\  |  _ \\ 
     | ' /   / _ \\ | |_) || | | |_| || || ' /  | ' /| | | | |\\/| | / _ \\ | |_) |
     | . \\  / ___ \\|  _ < | | |  _  || || . \\  | . \\| |_| | |  | |/ ___ \\|  _ < 
     |_|\\_\\/_/   \\_\\_| \\_\\|_| |_| |_|___|_|\\_\\ |_|\\_\\\\___/|_|  |_/_/   \\_\\_| \\_\\
      `);
      console.log("%c [HINT]: SYSTEM_OVERRIDE_CODE = U U D D L R L R B A ", "color: #38bdf8; font-size: 12px; font-family: monospace;");
    });

    // Konami Code Protocol
    let konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiPosition = 0;
    
    document.addEventListener('keydown', function(e) {
      if (e.key === konamiCode[konamiPosition]) {
        konamiPosition++;
        if (konamiPosition === konamiCode.length) {
          alert('KONAMI CODE ACCEPTED. ENGAGING RAW TERMINAL OVERRIDE.');
          document.body.innerHTML = document.body.innerHTML.replace(/<[^>]*>?/gm, '');
          document.body.style.cssText = "background: #000; color: #0f0; font-family: monospace; font-size: 16px; padding: 20px; white-space: pre-wrap;";
          konamiPosition = 0;
        }
      } else {
        konamiPosition = 0;
      }
    });
  </script>
</head>
<body>
  <MouseTrail client:only="react" />
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Terminal client:load />

  <header class="top-nav">
    <div class="nav-container">
      <a href="/" class="brand font-mono text-ice">KARTHIK_KUMAR</a>
      <nav aria-label="Primary navigation">
        <ul>
          <li><a href="/work" class="font-mono">/WORK</a></li>
          <li><a href="/profile" class="font-mono">/PROFILE</a></li>
          <li><a href="/resume" class="font-mono">/RESUME</a></li>
          <li><a href="/contact" class="font-mono text-crimson">/CONTACT</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container font-mono text-muted">
      <p>&copy; {new Date().getFullYear()} Karthik Kumar // SYSTEM_ONLINE</p>
      <p class="terminal-hint">[PRESS '~' FOR SECURE ACCESS]</p>
    </div>
  </footer>

  <DataTicker client:load />
  <DefconToggle client:load />
</body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--color-crimson);
    color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    z-index: 100;
  }

  .skip-link:focus {
    top: 0;
  }

  .top-nav {
    border-bottom: var(--border-hairline);
    padding: var(--space-4) 0;
    background: rgba(5, 5, 5, 0.8);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-8);
  }

  nav a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  nav a:hover,
  nav a:focus {
    color: var(--color-text-main);
  }

  .site-footer {
    margin-top: var(--space-32);
    padding: var(--space-8) 0;
    border-top: var(--border-hairline);
    text-align: center;
    font-size: 0.75rem;
    margin-bottom: 40px; /* Space for ticker */
  }

  .terminal-hint {
    opacity: 0.3;
    margin-top: var(--space-2);
    transition: all 0.3s ease;
  }
  
  .terminal-hint:hover {
    opacity: 1;
    color: var(--color-crimson);
  }

  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      gap: var(--space-4);
    }

    nav ul {
      gap: var(--space-4);
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
