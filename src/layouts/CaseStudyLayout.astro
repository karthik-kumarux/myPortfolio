---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Project } from '@/content/projects';

interface Props {
  project: Project;
  status: string;
}

const { project, status } = Astro.props;
---

<BaseLayout title={`${project.title} — Karthik Kumar`} description={project.summary}>
  <article class="case-study">
    <header class="cs-header">
      <div class="cs-meta">
        <span class="cs-type font-mono">[{project.storytellingMode}]</span>
        <span class="cs-status font-mono text-crimson">{status}</span>
      </div>
      <h1>{project.title}</h1>
      <p class="cs-summary font-mono text-ice">{project.summary}</p>

      {project.links?.github && (
        <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="button font-mono">VIEW_SOURCE</a>
      )}
    </header>

    <div class="cs-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .case-study {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .cs-header {
    max-width: var(--reading-max);
    margin-bottom: var(--space-16);
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-8);
  }

  .cs-meta {
    display: flex;
    gap: var(--space-4);
    font-size: 0.875rem;
    margin-bottom: var(--space-4);
  }

  .cs-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    line-height: 1.1;
  }

  .cs-summary {
    font-size: 1rem;
    margin-bottom: var(--space-8);
    max-width: 800px;
  }

  .button {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--border-hairline);
    background: transparent;
    color: var(--color-text-main);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .button:hover,
  .button:focus {
    border-color: var(--color-crimson);
    background: var(--color-crimson-glow);
  }

  .cs-content {
    max-width: var(--reading-max);
  }

  .cs-content section {
    margin-bottom: var(--space-16);
  }

  .cs-content h2 {
    font-size: 1.5rem;
    text-transform: uppercase;
    border-bottom: var(--border-hairline);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-8);
    color: var(--color-ice-blue);
  }

  .cs-content p {
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .technical-list {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-8);
  }

  .technical-list li {
    padding-left: var(--space-6);
    position: relative;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  .technical-list li::before {
    content: ">>";
    position: absolute;
    left: 0;
    color: var(--color-crimson);
    font-family: var(--font-mono);
  }

  .technical-list strong {
    color: var(--color-text-main);
    font-weight: 500;
  }

  .architecture-figure {
    background: rgba(15, 15, 17, 0.5);
    border: var(--border-hairline);
    padding: var(--space-6);
    overflow-x: auto;
    margin-bottom: var(--space-8);
    position: relative;
  }
  
  .architecture-figure::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-ice-blue);
  }

  .architecture-figure pre {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-main);
  }
</style>
